# ---------------------------------------------------------------------------
# SiPinjam Kampus — environment Docker Compose (root project)
#
# SALIN ke `.env` di root, lalu isi nilainya. File `.env` TIDAK di-commit.
#
#   cp .env.example .env
#
# Berkas ini hanya berisi variabel yang dibaca compose.yaml (port, domain,
# tag image). Kredensial Laravel (APP_KEY, DB Supabase, mail) ada di
# backend/.env — hasilkan dari backend/.env.example.
# ---------------------------------------------------------------------------

# Port yang dipublish ke LOOPBACK saja. Nginx host meneruskan ke sini.
# Port 80/443 tidak dipakai Docker.
FRONTEND_PORT=8080
BACKEND_PORT=8081

# Domain produksi
APP_URL=https://api.webisdepinjam.cloud
FRONTEND_URL=https://app.webisdepinjam.cloud

# Kosong = frontend memanggil API same-origin (/api lewat Nginx host).
# Isi hanya jika ingin memanggil https://api.webisdepinjam.cloud langsung.
VITE_BACKEND_URL=
VITE_ERROR_PAGE_URL=

# Tag image untuk memudahkan rollback (contoh: 2026-11-13).
IMAGE_TAG=latest

# Migrasi otomatis saat start. Biarkan false; jalankan migrasi manual
# (lihat DEPLOYMENT.md bagian "Migrasi database").
AUTO_MIGRATE=false
