# ---------------------------------------------------------------------------
# Contoh variabel environment
# ---------------------------------------------------------------------------
# SALIN manual ke backend/.env (atau gunakan .env di root untuk Docker Compose).
# Jangan pernah commit file .env yang berisi kredensial asli.
#
# Untuk deployment Docker, nilai produksi diambil dari compose.yaml yang
# membaca .env di ROOT project (bukan backend/.env).
# ---------------------------------------------------------------------------

APP_NAME=SiPinjam
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.webisdepinjam.cloud

# URL frontend (dipakai untuk link reset password di email)
FRONTEND_URL=https://app.webisdepinjam.cloud

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

# Proxy Nginx host di depan container (lihat config/proxy.php)
TRUSTED_PROXIES=*

HASH_DRIVER=bcrypt
BCRYPT_ROUNDS=12

# Logging ke stderr agar terbaca `docker compose logs`.
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Database: PostgreSQL Supabase (Session Pooler / Direct Connection)
# Isi dari dashboard Supabase > Project Settings > Database.
# Jika memakai connection pooler, sertakan project-ref di username,
# contoh: postgres.<project-ref>
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# ---------------------------------------------------------------------------
# Redis: di Docker gunakan nama service `redis` (lihat compose.yaml).
# Untuk development lokal bisa 127.0.0.1.
# ---------------------------------------------------------------------------
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Kosongkan bila frontend & API berada di subdomain berbeda (token Bearer).
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Queue: sync karena project tidak memiliki job antrian.
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# Batas ukuran request (byte). Harus selaras nginx & php.ini (50 MB).
MAX_CONTENT_LENGTH=52428800

# CORS. Untuk same-origin tidak diperlukan; isi jika frontend memanggil
# API langsung ke api.webisdepinjam.cloud.
CORS_ALLOWED_ORIGINS=https://app.webisdepinjam.cloud

# Sanctum memakai token Bearer (createToken) sehingga stateful cookie
# tidak dipakai. Biarkan kosong.
# SANCTUM_STATEFUL_DOMAINS=app.webisdepinjam.cloud

# ---------------------------------------------------------------------------
# Mail (wajib diisi untuk fitur lupa password)
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@webisdepinjam.cloud
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
